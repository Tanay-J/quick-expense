<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Month Spend + Today Badge + Quick Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_header_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ DROPSPEND · THIS MONTH"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_month_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_today_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Today ₹0"
                    android:textColor="#93C5FD"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/widget_quick_add_btn"
            android:layout_width="62dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+ Add"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pace Meta Line -->
    <TextView
        android:id="@+id/widget_pace_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="₹30,000 left · Tap + Add or a Usual below"
        android:textColor="#CBD5E1"
        android:textSize="11sp" />

    <!-- 1-Tap Usuals Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_usual_1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="☕ Coffee ₹150"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_usual_2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="⛽ Fuel ₹200"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_usual_3"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="🛒 Snacks ₹100"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
